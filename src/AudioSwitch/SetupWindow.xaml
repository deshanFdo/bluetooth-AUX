<Window x:Class="AudioSwitch.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Switch Installer"
        Icon="pack://application:,,,/Assets/AudioSwitch.ico"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Border Margin="14"
            CornerRadius="22"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F407090F" Offset="0"/>
                <GradientStop Color="#F20C111D" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#58FFFFFF" Offset="0"/>
                <GradientStop Color="#383B82F6" Offset="0.55"/>
                <GradientStop Color="#2210B981" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <StackPanel Margin="22,20,22,20">
            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42" CornerRadius="21" Background="#283B82F6" BorderBrush="#6660A5FA" BorderThickness="1" Margin="0,0,12,0">
                    <Path Data="{StaticResource IconHeadphones}" Fill="#60A5FA" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Audio Switch" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="SubtitleText" Text="Dynamic Island Setup • v1.1.0 (Windows x64)" FontSize="11.2" Foreground="#94A3B8"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButtonStyle}" Click="CloseBtn_Click"/>
            </Grid>

            <!-- Feature summary -->
            <Border CornerRadius="12" Background="#460C1220" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Install Location" FontSize="10.2" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                    <TextBlock x:Name="InstallPathText" Text="%LocalAppData%\Programs\AudioSwitch" FontSize="11" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border x:Name="OptionsCard" CornerRadius="12" Background="#460C1220" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="StartMenuCheck" IsChecked="True" Content="Add Start Menu shortcut" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,7"/>
                    <CheckBox x:Name="DesktopCheck" IsChecked="True" Content="Create Desktop shortcut" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,7"/>
                    <CheckBox x:Name="StartupCheck" IsChecked="True" Content="Start automatically with Windows (0% idle CPU tray icon)" Foreground="#E2E8F0" FontSize="11.5"/>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <StackPanel x:Name="ProgressPanel" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="ProgressLabel" Text="Installing..." FontSize="11" Foreground="#93C5FD" Margin="0,0,0,6"/>
                <Border Height="6" CornerRadius="3" Background="#24FFFFFF" ClipToBounds="True">
                    <Border x:Name="ProgressFill" CornerRadius="3" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#10B981" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource GlassActionButtonStyle}" HorizontalAlignment="Left" Padding="14,7" Click="CloseBtn_Click"/>
                <Button x:Name="PrimaryActionBtn"
                        Grid.Column="1"
                        Content="Install Audio Switch"
                        Style="{StaticResource GlassActionButtonStyle}"
                        Background="#CC2563EB"
                        BorderBrush="#9960A5FA"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        Padding="18,8"
                        Click="PrimaryActionBtn_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
